{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "mode": "auto-allow",
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["./"],
      "denyWrite": ["~/.ssh", "~/.aws", "~/.claude", "/etc", "/root"],
      "denyRead": ["~/.ssh", "~/.aws"]
    }
  }
}
