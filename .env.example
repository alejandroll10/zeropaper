# Credentials and identity for a deployed pipeline.
#
# setup.sh copies this repo's `.env` into every new project, then appends any
# key listed here that the copy is missing (blank, for you to fill in) — so a
# personal .env that predates a key still deploys it. If you haven't made one
# yet, copy this file to `.env` and fill in what you need — setup.sh falls
# back to this template so a deployment always gets a scaffold to edit.
#
# Only fill in what your flags actually use: the identity block is always worth
# setting, OPENALEX_API_KEY is worth setting for every variant, and the rest are
# per-extension. A blank value is treated as absent.
#
# Keep a trailing newline at the end of this file. update.sh merges new keys
# into existing deployments line by line, and an unterminated final line is
# silently skipped.

# ── Identity ──
# EMAIL is sent as the `mailto` identifier on OpenAlex and Crossref requests.
# NAME and UNIVERSITY are not read by any current code path — they are kept so
# existing deployments keep them, but nothing consumes them. In particular they
# do NOT reach the manuscript: papers ship an anonymized \author line for
# double-blind review and the pipeline is forbidden to de-anonymize them.
NAME=
EMAIL=
UNIVERSITY=

# ── OpenAlex — literature search, novelty checks, bibliography verification ──
# Free, no card. Make an account at https://openalex.org, then copy the key from
# https://openalex.org/settings/api
#
# Strongly recommended for ALL variants. OpenAlex bills a daily credit budget:
# a key gives 10,000 credits/day and the budget is per-key, while going keyless
# drops you to a 1,000/day demo tier that is shared across every process on the
# host. A title search costs 10 credits and a DOI/ID lookup is free, so keyless
# runs get ~100 searches/day for the whole machine — which several concurrent
# pipelines will exhaust, producing 429s that last until 00:00 UTC.
OPENALEX_API_KEY=

# ── OpenCode runtime ──
# OpenCode Zen provider key. The deployed runtime is pinned to
# opencode/deepseek-v4-flash.
OPENCODE_API_KEY=

# ── --ext empirical ──
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html (free)
FRED_API_KEY=
# WRDS account: https://wrds-www.wharton.upenn.edu/
WRDS_USER=
WRDS_PASS=
# BLS (free, OPTIONAL — raises the daily query cap; keyless still works):
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Census (free, REQUIRED for every ACS/CPS request — the keyless <500/day tier
# was retired, and bare requests now return an HTML "Missing Key" page rather
# than JSON): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# SEC EDGAR requires a real name and email in the User-Agent header — no
# registration, but the defaults are generic and SEC may throttle or block them.
SEC_EDGAR_NAME=
SEC_EDGAR_EMAIL=
# DeepVest AI research terminal (MCP server at api.deepvest.ai/mcp) — OPTIONAL,
# metered: 1,000 free credits/month per account, then $0.025/credit. Create a
# key at https://console.deepvest.ai/dashboard/api-keys (account at
# https://www.deepvest.ai). Used by the `deepvest` skill / code/utils/deepvest_utils.py.
DEEPVEST_API_KEY=
# EDGAR local cache — OPTIONAL override, leave commented unless relocating it.
# The pipeline defaults it to data/edgar_cache/ inside the project
# (code/utils/edgar_utils.py + the edgar skill); edgartools' own ~/.edgar
# default is outside the sandbox writable set and fails with PermissionError.
# EDGAR_LOCAL_DATA_DIR=

# ── --ext theory_llm ──
# UF NaviGator API key for LLM experiments: https://api.ai.it.ufl.edu
UF_API_KEY=
# DeepInfra, for cross-family replication of LLM experiments: https://deepinfra.com
DEEPINFRA_TOKEN=
# Frontier proprietary tiers (pay-per-token, OPTIONAL) — the models most readers
# care about in a cross-family comparison. llm_client.py routes `gpt-*`/`o*` to
# OpenAI (Chat Completions) and `claude-*` to Anthropic (native Messages API).
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Local/self-hosted backend (Ollama, LM Studio, vLLM, ...) — no signup, no key.
# Set MODEL to any tag you have pulled; BASE_URL defaults to Ollama's and the
# API key is ignored by most local servers. A cloud backend wins if both are
# configured. Leave blank unless you are running experiments against a local model.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
