{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/institute-for-automated-research/auto-ai-research-template/schemas/analysis-contract-v1.schema.json",
  "title": "Empirical project baseline or analysis contract",
  "$comment": "Structural preflight only. analysis_contract.py is the canonical validator for identity, references, DAG closure, and deviations.",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "idMap": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"type": "object"}
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {"$ref": "#/$defs/idMap"},
        "samples": {"$ref": "#/$defs/idMap"},
        "variables": {"$ref": "#/$defs/idMap"},
        "procedures": {"$ref": "#/$defs/idMap"},
        "inference": {"$ref": "#/$defs/idMap"},
        "outputs": {"$ref": "#/$defs/idMap"}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_kind", "baseline_id", "definitions"],
      "properties": {
        "schema_version": {"const": 1},
        "record_kind": {"const": "project_baseline"},
        "baseline_id": {"$ref": "#/$defs/id"},
        "definitions": {"$ref": "#/$defs/sections"},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_kind", "analysis_id", "purpose", "baseline", "effective", "deviations"],
      "properties": {
        "schema_version": {"const": 1},
        "record_kind": {"const": "analysis_contract"},
        "analysis_id": {"$ref": "#/$defs/id"},
        "reference_analysis_id": {"$ref": "#/$defs/id"},
        "purpose": {"type": "string", "minLength": 1},
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "semantic_digest"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "effective": {
          "allOf": [{"$ref": "#/$defs/sections"}],
          "required": ["inputs", "samples", "variables", "procedures", "inference", "outputs"]
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["paths", "reason"],
            "properties": {
              "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/effective/"}},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "notes": {"type": "string", "minLength": 1}
      }
    }
  ]
}
