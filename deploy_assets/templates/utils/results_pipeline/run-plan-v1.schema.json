{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alejandroll10/zeropaper/schemas/run-plan-v1.schema.json",
  "title": "ZeroPaper pre-run evidence declaration",
  "$comment": "Structural preflight only. results_pipeline.py is the canonical semantic validator for normalized paths, cross-field equality, collisions, and lifecycle state.",
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$))(?!.*//)(?!\\.[Gg][Ii][Tt](?:/|$))(?!\\.[Ee][Nn][Vv][^/]*(?:/|$))(?!.*\\/(?:\\.[Gg][Ii][Tt]|\\.[Ee][Nn][Vv][^/]*)(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    },
    "outputPath": {
      "type": "string",
      "pattern": "^(?!.*//)output/(?![Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee](?:/|$))(?!.*\\\\)(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$))(?!\\.[Gg][Ii][Tt](?:/|$))(?!\\.[Ee][Nn][Vv][^/]*(?:/|$))(?!.*\\/(?:\\.[Gg][Ii][Tt]|\\.[Ee][Nn][Vv][^/]*)(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version", "producer_code", "producer_inputs", "artifacts",
    "renderer_code", "exhibits"
  ],
  "properties": {
    "plan_version": {"type": "integer", "const": 1},
    "producer_code": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "producer_inputs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "artifacts": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/outputPath"}
    },
    "renderer_code": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "exhibits": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/outputPath"}
    },
    "provider_credentials": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": [
          "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "UF_API_KEY", "DEEPINFRA_TOKEN",
          "LOCAL_LLM_API_KEY"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"exhibits": {"minItems": 1}}},
      "then": {"properties": {"renderer_code": {"minItems": 1}}}
    }
  ]
}
