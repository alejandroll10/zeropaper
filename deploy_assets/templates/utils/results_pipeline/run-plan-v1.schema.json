{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alejandroll10/zeropaper/schemas/run-plan-v1.schema.json",
  "title": "ZeroPaper pre-run evidence declaration",
  "$comment": "Structural preflight only. results_pipeline.py is the canonical semantic validator for normalized paths, cross-field equality, collisions, and lifecycle state.",
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$))(?!.*//)(?!\\.[Gg][Ii][Tt](?:/|$))(?!\\.[Ee][Nn][Vv][^/]*(?:/|$))(?!.*\\/(?:\\.[Gg][Ii][Tt]|\\.[Ee][Nn][Vv][^/]*)(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    },
    "outputPath": {
      "type": "string",
      "pattern": "^(?!.*//)output/(?![Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee](?:/|$))(?!.*\\\\)(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$))(?!\\.[Gg][Ii][Tt](?:/|$))(?!\\.[Ee][Nn][Vv][^/]*(?:/|$))(?!.*\\/(?:\\.[Gg][Ii][Tt]|\\.[Ee][Nn][Vv][^/]*)(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version", "producer_code", "producer_inputs", "artifacts",
    "renderer_code", "exhibits"
  ],
  "properties": {
    "plan_version": {"type": "integer", "const": 1},
    "producer_code": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "producer_inputs": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "artifacts": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/outputPath"}
    },
    "renderer_code": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectPath"}
    },
    "renderer_inputs": {
      "type": "array", "uniqueItems": true,
      "description": "Declared artifact subset exposed to the renderer; empirical execution summaries must be excluded.",
      "items": {"$ref": "#/$defs/outputPath"}
    },
    "analyses": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "execution_summary", "input_bindings"],
        "properties": {
          "contract": {"$ref": "#/$defs/projectPath"},
          "execution_summary": {"$ref": "#/$defs/outputPath"},
          "input_bindings": {
            "type": "object",
            "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
            "additionalProperties": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"$ref": "#/$defs/projectPath"}
            }
          }
        }
      }
    },
    "exhibits": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/outputPath"}
    },
    "provider_credentials": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": [
          "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "UF_API_KEY", "DEEPINFRA_TOKEN",
          "LOCAL_LLM_API_KEY"
        ]
      }
    },
    "network_access": {
      "type": "boolean",
      "description": "Whether the producer receives outbound network capability. Defaults to true for backward compatibility; dataset release builds must set false."
    },
    "requires_dataset_release": {
      "type": "boolean",
      "description": "Marks a data-first analysis receipt that may activate only with its bound dataset release. Defaults to false."
    },
    "dataset_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact", "manifest", "rights_inventory", "rights_inventory_sha256",
        "input_provenance", "rights_authority",
        "dataset_version", "analysis_receipt", "producing_receipt"
      ],
      "properties": {
        "artifact": {"$ref": "#/$defs/outputPath"},
        "manifest": {"$ref": "#/$defs/outputPath"},
        "rights_inventory": {"$ref": "#/$defs/projectPath"},
        "rights_inventory_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rights_authority": {
          "enum": ["gate2-state", "manual-caller"],
          "description": "Autonomous releases bind to the Gate-2 state pointer; manual data-first releases bind to the caller's explicit path/digest/version declaration. The runner cross-checks this value against .deploy_manifest.json."
        },
        "input_provenance": {"$ref": "#/$defs/projectPath"},
        "dataset_version": {"type": "integer", "minimum": 1},
        "analysis_receipt": {"$ref": "#/$defs/outputPath"},
        "producing_receipt": {"$ref": "#/$defs/outputPath"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"exhibits": {"minItems": 1}}},
      "then": {"properties": {"renderer_code": {"minItems": 1}}}
    }
  ]
}
