{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alejandroll10/zeropaper/schemas/results-v1.schema.json",
  "title": "ZeroPaper paper-facing result bundle",
  "$comment": "Structural preflight only. results_pipeline.py is the canonical semantic validator for normalized paths, cross-references, duplicate path/id ownership, plan equality, and lifecycle state.",
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$))(?!.*//)(?!\\.[Gg][Ii][Tt](?:/|$))(?!\\.[Ee][Nn][Vv][^/]*(?:/|$))(?!.*\\/(?:\\.[Gg][Ii][Tt]|\\.[Ee][Nn][Vv][^/]*)(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    },
    "outputPath": {
      "type": "string",
      "pattern": "^(?!.*//)output/(?![Ee][Vv][Ii][Dd][Ee][Nn][Cc][Ee](?:/|$))(?!.*\\\\)(?!\\.\\.?/)(?!.*(?:/\\.\\.?/|/\\.\\.?$))(?!\\.[Gg][Ii][Tt](?:/|$))(?!\\.[Ee][Nn][Vv][^/]*(?:/|$))(?!.*\\/(?:\\.[Gg][Ii][Tt]|\\.[Ee][Nn][Vv][^/]*)(?:/|$))(?!.*[\\u0000-\\u001F]).+$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "results", "artifacts", "renderer", "exhibits"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "inputs", "reproducibility"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "code": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/projectPath"}
        },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/projectPath"}
        },
        "reproducibility": {"enum": ["exact", "bounded", "captured"]},
        "notes": {"type": "string"}
      }
    },
    "results": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9._-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "value": {},
          "unit": {"type": "string"},
          "display": {"type": "object"},
          "uncertainty": {"type": "object"},
          "artifact": {
            "$ref": "#/$defs/outputPath"
          },
          "selector": {"type": "string"},
          "metadata": {"type": "object"}
        },
        "anyOf": [
          {"required": ["value"]},
          {"required": ["artifact"]}
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": {
            "$ref": "#/$defs/outputPath"
          },
          "description": {"type": "string", "minLength": 1},
          "media_type": {"type": "string"}
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/projectPath"}
        },
        "notes": {"type": "string"}
      }
    },
    "exhibits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "description", "result_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"enum": ["table", "figure"]},
          "path": {
            "$ref": "#/$defs/outputPath"
          },
          "description": {"type": "string", "minLength": 1},
          "result_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"exhibits": {"minItems": 1}}},
      "then": {
        "properties": {
          "renderer": {"properties": {"code": {"minItems": 1}}}
        }
      }
    }
  ]
}
