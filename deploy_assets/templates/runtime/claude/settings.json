{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "mode": "auto-allow",
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["./", "/tmp", "$TMPDIR", "~/.codex", "~/.cache", "~/Library/Caches", "~/.matplotlib"],
      "denyWrite": ["~/.cache/zeropaper/wrds", "~/.ssh", "~/.aws", "~/.claude", "/etc", "/root"],
      "denyRead": ["~/.ssh", "~/.aws"]
    }
  }
}
