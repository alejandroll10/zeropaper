{
  "network": {
    "mode": "unrestricted"
  },
  "filesystem": {
    "allowWrite": [
      ".",
      "/tmp",
      "process_log/.opencode-runtime",
      "~/.cache/uv",
      "~/.cache/pip",
      "~/.cache/matplotlib",
      "~/.cache/fontconfig",
      "~/.cache/gdown",
      "~/.cache/huggingface",
      "~/.cache/torch",
      "~/.cache/ms-playwright",
      "~/.cache/opencode",
      "~/Library/Caches",
      "~/.matplotlib",
      "~/.codex"
    ],
    "denyWrite": [
      "~/.cache/zeropaper/wrds",
      ".opencode",
      "process_log/.opencode-control",
      ".env",
      ".deploy_manifest.json",
      "launch.sh",
      "opencode.json",
      "~/.ssh",
      "~/.aws",
      "~/.claude",
      "~/.codex/auth.json",
      "~/.codex/config.toml",
      "~/.codex/plugins",
      "~/.codex/skills",
      "~/.codex/rules",
      "~/.codex/packages",
      "/etc",
      "/root"
    ],
    "denyRead": [
      "~/.ssh",
      "~/.aws"
    ]
  }
}
