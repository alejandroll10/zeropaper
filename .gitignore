# Project directories (created by setup.sh in deployed projects)
code/
data/
output/
paper/
process_log/
references/
.claude/agents/
.claude/agent-memory/
# .claude/skills/ is deliberately NOT ignored: the meta-repo's own dev skills
# are tracked here. Deployments start empty and assemble their own skill trees
# exclusively from deploy_assets/, so the dev skills never enter a project.

# Local test artifacts from ./setup.sh <name> --assemble-only
demo_*/

# Paper about the pipeline — lives in its own repo
paper-system/

# Local skill-test sandbox (replicates a deployed project for skill verification)
_skill_test_sandbox/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# R
.Rhistory
.RData
.Rproj.user/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Meta paper (separate repo)
meta_paper/

# Dev-only notes / postmortems / one-off audits. Repo working notes that must
# never be committed; setup.sh's allowlisted deployment does not ship them.
dev_notes/

# API keys
.env

# Local test output from setup.sh --assemble-only
test_output/
test_example/

# Scratch
texput.log

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.bcf
paper/*.log
paper/*.out
paper/*.pdf
paper/*.run.xml
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/*.toc
paper/*.lof
paper/*.lot
paper/*-SAVE-ERROR
codex_inspect/
local_testing/
run_lessons/
