# WRDS server runtime — legacy/defensive. Current wrds_server.py writes its
# PID host-globally ($XDG_RUNTIME_DIR or temp dir), not into code/utils/. This
# rule still protects projects deployed on older code, and the brief window
# during an update.sh refresh, from a stray tracked pid file.
code/utils/.wrds_server.pid

# Process log runtime output (e.g. wrds_server.log from start_services.sh,
# driver.log + rotations from launch.sh's codex driver loop); committed
# process-log artifacts under process_log/ are added explicitly by scribe.
process_log/*.log
process_log/driver.log.*

# launch.sh codex-driver session cache (host-local codex session id — resuming
# on another host would be meaningless; never a tracked artifact)
process_log/.codex_session_id
process_log/.opencode_session_id
process_log/opencode-driver.log
process_log/opencode-server.log
process_log/.opencode_server_pid
