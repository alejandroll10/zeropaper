\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arpipeline}[{{ARP_DATE}} auto-ai-research-template fingerprint]
%
% =====================================================================
% auto-ai-research-template — pipeline fingerprint package
% DO NOT MODIFY OR REMOVE THIS FILE.
% Pipeline tooling (dashboard, deployment audit, downstream verification)
% relies on the fingerprint constants defined here. Removing this file
% or its values may cause pipeline stages to fail or produce
% misattributed output.
% =====================================================================
%
% Magic detection prefix: ARPIPELINE-FP-V1
%
% Single-shot grep across any output recovers a paper produced by an
% auto-ai-research-template deployment:
%
%   pdftotext paper.pdf - | grep ARPIPELINE-FP-V1   (Layer 4, page text)
%   pdfinfo  paper.pdf    | grep ARPIPELINE-FP-V1   (Layer 2, metadata)
%   qpdf --qdf - paper.pdf - | grep ARPIPELINE-FP-V1 (Layer 3, /Info dict)
%
% Payload format wherever this string appears:
%   ARPIPELINE-FP-V1[uuid={UUID},ver={VERSION},date={DATE}]
%
% Required packages — loaded defensively so this .sty works regardless of
% what main.tex has already imported. xcolor is hoisted via
% \PassOptionsToPackage so a later \usepackage[opts]{xcolor} from the user
% does not trigger an option clash. atbegshi provides \AtBeginShipout /
% \AtBeginShipoutUpperLeft on TeX Live ≤ 2020; on newer distributions it
% is folded into l3backend and the \RequirePackage no-ops.
\PassOptionsToPackage{}{xcolor}
\RequirePackage{xcolor}
\RequirePackage{atbegshi}
%
% Layer 1 — fingerprint constants in source (not expanded into output)
\newcommand{\arpFingerprint}{{{ARP_UUID}}}
\newcommand{\arpVersion}{{{ARP_VERSION}}}
\newcommand{\arpDeployed}{{{ARP_DATE}}}
\newcommand{\arpMagic}{ARPIPELINE-FP-V1}
\newcommand{\arpPayload}{\arpMagic[uuid=\arpFingerprint,ver=\arpVersion,date=\arpDeployed]}
%
% Layer 2 — PDF metadata via hyperref. The magic prefix is prepended to
% pdfsubject so `pdfinfo paper.pdf | grep ARPIPELINE-FP-V1` finds it.
% Caveat: if the document class or a later-loaded package issues its own
% \hypersetup inside \AtBeginDocument, hook order is FIFO and a class-
% level call may overwrite these settings. Layer 3 and Layer 4 still hold.
\AtBeginDocument{%
  \makeatletter%
  \@ifpackageloaded{hyperref}{%
    \hypersetup{%
      pdfproducer={auto-ai-research-template \arpVersion},%
      pdfkeywords={\arpPayload},%
      pdfsubject={\arpPayload\space Generated by auto-ai-research-template; run-id \arpFingerprint}%
    }%
  }{}%
  \makeatother%
}
%
% Layer 3 — custom /Info dictionary entries via \pdfinfo. Values are
% prefixed with the magic string so a raw PDF dump also catches them
% via `qpdf --qdf - paper.pdf - | grep ARPIPELINE-FP-V1`.
% Engine guard: \pdfinfo is a pdfTeX primitive; absent under XeTeX and
% LuaTeX. Skip Layer 3 silently when the primitive is undefined; Layers
% 1, 2, and 4 still carry the fingerprint under those engines.
\AtBeginDocument{%
  \ifx\pdfinfo\undefined\else
    \pdfinfo{%
      /arpFingerprint (ARPIPELINE-FP-V1::{{ARP_UUID}})%
      /arpVersion (ARPIPELINE-FP-V1::{{ARP_VERSION}})%
      /arpDeployed (ARPIPELINE-FP-V1::{{ARP_DATE}})%
    }%
  \fi
}
%
% Layer 4 — white-on-white text injected on EVERY shipped page via
% \AtBeginShipout. Visually invisible on a white background but extracted
% as plain ASCII by `pdftotext`. Per-page placement (rather than a single
% end-of-document marker) makes distribution detection robust against
% page-level cropping or partial extraction — any single page from the
% paper still carries the fingerprint. Wrapped in \smash and \hbox so the
% injection has zero box dimensions and does not perturb page layout.
% Placed at upper-left of paper (offset by \put(0,0)) where it sits over
% the page margin in white text, invisible against a white page.
% Caveats: visible under dark-mode PDF readers, on non-white backgrounds,
% when page text is selected, and on zero-margin classes (e.g. beamer
% submission templates) where the upper-left coord is inside the text
% area.
\AtBeginShipout{%
  \AtBeginShipoutUpperLeft{%
    \put(0,0){\smash{\hbox{\color{white}\tiny\arpPayload}}}%
  }%
}
%
% =====================================================================
% Layer 5 — build-time table-legibility instrumentation (issue #85)
% ---------------------------------------------------------------------
% A wide results table wrapped in \resizebox{\textwidth}{!}{<tabular>}
% scales to exactly \textwidth and therefore can NEVER emit an
% "Overfull \hbox" — so the Stage-5 build-verify overfull gate is blind
% to it by construction, and the table can ship in microscopic,
% unreadable font. This wraps \resizebox so that when it scales a *table*
% (content that opens a tabular) below a legibility floor, it writes the
% distinctive token ARPIPELINE-SHRUNK to the .log; the Stage-5 gate greps
% for it. We measure the REALIZED scale (final box width / natural box
% width) rather than parse the size argument ourselves — this lets
% graphicx do its own argument parsing and correctly distinguishes a
% shrink-down (flagged) from a harmless stretch-up (ignored, scale >= 1).
% Figures are excluded: only content that actually opens a tabular sets
% the flag, so a legitimately down-scaled figure is not touched. Entirely
% no-ops if graphicx / \resizebox is not loaded. Helper macros are
% defined here at load time (so their parameter text is not stored inside
% the \AtBeginDocument hook); the \let/\def rewiring happens at
% begin-document, after every package — incl. graphicx — has loaded.
\newif\ifarp@tabseen
\newsavebox{\arp@natbox}
\newsavebox{\arp@resbox}
\newcommand{\arp@legfloor}{0.6}% flag a table scaled below this fraction of its natural width
% (@ is already a letter inside a package — no \makeatletter needed here, and a
%  stray \makeatother would mis-tokenize the @-commands in the hook read below.)
\newcommand{\arp@resizebox@star}[3]{\arp@orig@resizebox*{#1}{#2}{#3}}% starred form: pass through, not measured
\newcommand{\arp@resizebox@plain}[3]{%
  \global\arp@tabseenfalse
  \sbox\arp@natbox{#3}%                                   natural content (sets the flag if a tabular ran)
  \sbox\arp@resbox{\arp@orig@resizebox{#1}{#2}{\usebox\arp@natbox}}% graphicx parses the size arg
  \ifarp@tabseen
    \ifdim\wd\arp@resbox<\arp@legfloor\wd\arp@natbox
      \typeout{ARPIPELINE-SHRUNK: a table was scaled to \the\wd\arp@resbox\space from natural width \the\wd\arp@natbox\space (below the \arp@legfloor\space legibility floor) -- re-typeset it without \string\resizebox-shrinking (footnotesize/tabularx, a landscape/sidewaystable, or relegate it to the Internet Appendix).}%
    \fi
  \fi
  \usebox\arp@resbox
}
\AtBeginDocument{%
  \makeatletter
  % Mark whenever a tabular environment opens inside a measured box.
  \@ifundefined{tabular}{}{%
    \let\arp@orig@tabular\tabular
    \def\tabular{\global\arp@tabseentrue\arp@orig@tabular}%
  }%
  \@ifundefined{tabular*}{}{%
    \expandafter\let\expandafter\arp@orig@tabularstar\csname tabular*\endcsname
    \expandafter\def\csname tabular*\endcsname{\global\arp@tabseentrue\arp@orig@tabularstar}%
  }%
  % Wrap \resizebox (preserving its starred form) to measure table shrink.
  \@ifundefined{resizebox}{}{%
    \let\arp@orig@resizebox\resizebox
    \def\resizebox{\@ifstar{\arp@resizebox@star}{\arp@resizebox@plain}}%
  }%
  \makeatother
}
%
\endinput
